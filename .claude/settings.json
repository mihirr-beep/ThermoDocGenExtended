{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "P=./venv/Scripts/python.exe; [ -x \"$P\" ] || P=./venv/bin/python; [ -x \"$P\" ] || P=python; \"$P\" .claude/hooks/catalog_guard.py --check 2>/dev/null || true",
            "timeout": 60,
            "statusMessage": "Checking the schema catalog against the database"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "P=./venv/Scripts/python.exe; [ -x \"$P\" ] || P=./venv/bin/python; [ -x \"$P\" ] || P=python; \"$P\" .claude/hooks/catalog_guard.py --on-edit 2>/dev/null || true",
            "timeout": 120,
            "statusMessage": "Regenerating the schema catalog"
          }
        ]
      }
    ]
  }
}
