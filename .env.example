# MySQL Configuration
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=YourPasswordHere

# Application Environment (development / production / testing)
APP_ENV=development

# NL search (admin "Ask the Lab Data" page) - required for the feature to work
OPENAI_API_KEY=YourOpenAIKeyHere

# The model that plans and writes the SQL. gpt-4o-mini is the default: about
# $0.0014 a question against $0.023 for gpt-4o. Set this to gpt-4o if accuracy
# on multi-table questions matters more than cost.
# NLP_SEARCH_MODEL=gpt-4o-mini

# The model that CHECKS the answer against the rows the database returned.
# Worth pointing at a different model from the one above - a judge sharing the
# generator's blind spots nods through the same mistakes - and it is the
# cheaper of the two calls.
# NLP_VERIFY_MODEL=gpt-4o-mini

# Split a multi-part question into separate runs. OFF by default: measured on
# gpt-4o it changed nothing, and it broke questions whose phrasing selects a
# reviewed measure. Set to 1 to re-enable and re-measure.
# NLP_SPLIT=1

# Collapse the four domain workers into one author holding the whole schema.
# OFF by default - measured worse on accuracy, cost AND latency (10/13 vs
# 13/13, 292k vs 182k tokens). Here so the comparison can be repeated.
# NLP_SINGLE_AUTHOR=1

# There is no Pinecone / vector / RAG lane any more. The database is the only
# source: if a fact is not in a table, the assistant says so rather than
# retrieving it from an index that may be stale. PINECONE_* and NLP_EMBED_*
# settings are no longer read by anything.

# Langfuse tracing / observability (optional). When both keys are set, the NL
# search agent + LLM/embedding calls are traced to Langfuse over OpenTelemetry.
# Absent -> the feature runs untraced.
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_BASE_URL=https://cloud.langfuse.com     # EU cloud; US: https://us.cloud.langfuse.com
# LANGFUSE_SERVICE_NAME=emc-nl-search
# Admin usage dashboard caches Langfuse metrics this many seconds (avoids the
# public-API rate limit). Raise it if you still see rate-limit notices.
# NLP_USAGE_CACHE_TTL=120
