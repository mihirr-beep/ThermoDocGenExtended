# MySQL Configuration
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=YourPasswordHere

# Application Environment (development / production / testing)
APP_ENV=development

# NL search (admin "Ask the Lab Data" page)
OPENAI_API_KEY=YourOpenAIKeyHere
# Optional overrides:
# NLP_SEARCH_MODEL=gpt-4o-mini
# NLP_EMBED_MODEL=text-embedding-3-small

# Document search / RAG over generated datasheets (Pinecone). Optional - the
# DB path works without it; leave PINECONE_API_KEY unset to disable RAG.
# PINECONE_API_KEY=YourPineconeKeyHere
# PINECONE_INDEX=emc-datasheets
# PINECONE_CLOUD=aws
# PINECONE_REGION=us-east-1
# PINECONE_NAMESPACE=datasheets
