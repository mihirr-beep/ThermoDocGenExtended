# MySQL Configuration
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=YourPasswordHere

# Application Environment (development / production / testing)
APP_ENV=development

# NL search (admin "Ask the Lab Data" page) - required for the feature to work
OPENAI_API_KEY=YourOpenAIKeyHere
# Optional overrides:
# NLP_SEARCH_MODEL=gpt-4o-mini
# NLP_EMBED_MODEL=text-embedding-3-small

# Document search / RAG over generated datasheets (Pinecone). Optional - the
# NL->SQL path works without it; leave PINECONE_API_KEY unset to disable RAG.
# PINECONE_API_KEY=YourPineconeKeyHere
# PINECONE_INDEX=emc-datasheets
# PINECONE_CLOUD=aws
# PINECONE_REGION=us-east-1
# PINECONE_NAMESPACE=datasheets

# Embedding dimension. Auto-detected from an existing index; set this only to
# control the size when a NEW index is auto-created (must be <=1536 for
# text-embedding-3-small). e.g. NLP_EMBED_DIM=1024
# NLP_EMBED_DIM=1536

# Langfuse tracing / observability (optional). When both keys are set, the NL
# search agent + LLM/embedding calls are traced to Langfuse over OpenTelemetry.
# Absent -> the feature runs untraced.
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_BASE_URL=https://cloud.langfuse.com     # EU cloud; US: https://us.cloud.langfuse.com
# LANGFUSE_SERVICE_NAME=emc-nl-search
# Admin usage dashboard caches Langfuse metrics this many seconds (avoids the
# public-API rate limit). Raise it if you still see rate-limit notices.
# NLP_USAGE_CACHE_TTL=120
